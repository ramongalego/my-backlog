# Copy to .env and fill in. Never commit .env.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# A secret key (sb_secret_…), server only: saves shared metadata, links Steam, share pages and support tickets.
SUPABASE_SECRET_KEY=

# Steam Web API key (https://steamcommunity.com/dev/apikey): imports libraries and playtime.
STEAM_API_KEY=

# OpenAI: Pick My Game and the player profile on Stats.
OPENAI_API_KEY=

# IGDB, through a Twitch app (https://dev.twitch.tv/console/apps): adding games from other consoles.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional: SteamGridDB (https://www.steamgriddb.com/profile/preferences/api), wide art for console games IGDB lacks.
STEAM_GRID_API_KEY=
